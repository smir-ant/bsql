# Build artifacts
/target

# Editor swap files
*.swp
*.swo

# macOS Finder metadata
.DS_Store

# Claude Code session data
.claude/

*.txt

# The deps_pin gate's goldens ARE source of truth (like the trybuild
# `.stderr` goldens): they pin the resolved dependency set and the
# allowed version-duplications, and the gate fails on any drift. They
# must be committed despite the broad `*.txt` ignore above.
!tools/devgates/tests/deps_goldens/*.txt

# The next_event codegen gate's instruction-count ceiling is likewise a
# committed source-of-truth golden (regenerated with `BSQL_HOTPATH_PIN=overwrite`),
# so it too must survive the broad `*.txt` ignore above.
!crates/postgres/proto/tests/hotpath_goldens/*.txt
